<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= h @title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/Favicon.svg">
  <link rel="stylesheet" href="styles/customer_reset_pass.css">
</head>
<body>
  <div class="reset_page">
    <div class="reset_box">
      <% if @success %>
        <p class="success"><%= h @success %></p>
        <div class="reset_links">
          <a class="reset_pass" href="/login">Go back to login page</a>
          <a class="reset_pass" href="/reset-pass-success-email?loyalty_number=<%= h @customer.loyalty_number %>">
            Password reset confirmation email
          </a>
        </div>
      <% else %>
        <h1><%= h @title %></h1>

        <% @errors.each do |error| %>
          <p class="warning"><%= h error %></p>
        <% end %>

        <form action="/customer-reset-password" method="post">
          <p><label for="password">Enter new password:</label></p>
          <p><input type="password" id="password" name="password" /></p>
          <p><label for="conf_password">Confirm new password:</label></p>
          <p><input type="password" id="conf_password" name="conf_password" /></p>
          <p><button type="submit">Confirm</button></p>
        </form>
      <% end %>
    </div>
  </div>
</body>
</html>
