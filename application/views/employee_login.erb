<!DOCTYPE html>
<HTML>
<HEAD>
    <TITLE>Employee Login Page</TITLE>
    <link rel="icon" type="image/svg+xml" href="/images/Favicon.svg">
    <link rel='stylesheet' href='styles/manager/fonts.css'>
    <meta charset='UTF-8'>
    <STYLE>
        body {
            margin: 0;
            font-family: "OpenSauce", sans-serif;
            min-height: 100vh;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/images/lp-background.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        h1 {
            color: white;
            text-align: center;
            font-size: 2.5rem;
            margin-top: 40px;
            margin-bottom: 0;
        }

        .box {
            background-color: rgba(0, 0, 0, 0.65);
            width: 60%;
            margin: 30px auto;
            padding: 40px;
            border-radius: 10px;
            color: white;
        }

        .text {
            margin-bottom: 0.5rem;
            margin-top: 1rem;
            font-size: 1.2rem;
            color: white;
        }

        .text_input {
            width: 100%;
            height: 2.2rem;
            font-size: 1rem;
            padding: 0 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-family: "OpenSauce", sans-serif;
            box-sizing: border-box;
        }

        .error_text {
            color: #ff6b6b;
            font-size: 1rem;
            text-align: center;
            display: block;
            margin-bottom: 10px;
        }

        button {
            margin-top: 1.5rem;
            width: 40%;
            margin-left: 30%;
            height: 2.8rem;
            font-size: 1.2rem;
            background-color: #f0f0f0;
            border: 1px solid #ccc;
            border-radius: 4px;
            cursor: pointer;
            font-family: "OpenSauce", sans-serif;
        }

        button:hover {
            background-color: #e0e0e0;
        }

        .bottom-link {
            margin-top: 30px;
            text-align: center;
        }

        .bottom-link p {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 5px;
        }

        .bottom-link a {
            color: #87ceeb;
        }
    </STYLE>
</HEAD>
<BODY>
<H1>Employee Log-in</H1>
<DIV id="login_box" class="box">
    <a class="error_text">
    <% if params["error"] %>
        <%= params["error"] %>
    <% end %>
    <% unless @error.nil? %>
        <%= @error %>
    <% end %>
    </a>
    <FORM method="post" action="/employee-login-page">
        <p class="text">Enter Username:</p>
        <INPUT class="text_input" type="text" placeholder="Username" name="username">
        <p class="text">Enter Password:</p>
        <INPUT class="text_input" type="password" placeholder="Password" name="password">
        <button type="submit" name="login_button">Log-in</button>
    </FORM>
    <div class="bottom-link">
        <p>Shouldn't be here?</p>
        <a href="/">Click Here</a>
    </div>
</DIV>
</BODY>
</HTML>