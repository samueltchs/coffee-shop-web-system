<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= h @title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/Favicon.svg">
  <link rel="stylesheet" href="styles/email.css">
</head>
<body>
  <div class="email_page">
    <div class="email_details">
      <p><b>From: </b><%= h @sender_email %></p>
      <p><b>To: </b><%= h @receiver_email %></p>
      <p><b>Subject: </b><%= h @subject %></p>
    </div>

    <div class="email_container">
      <h1 class="email_brand"><%= @cafe_name.upcase %></h1>

      <div class="email_body">
        <p>Hi <%= h @receiver_name %>,</p>
