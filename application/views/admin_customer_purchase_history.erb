<%= erb :"common/admin_header" %>

<%= erb :"common/admin_top" %>

<h1><%= h @title %></h1>

<div class="logs">
  <a class="buttons" href="/admin-customer-activity-logs?loyalty_number=<%= h @customer.loyalty_number %>">
    <img src="icons/arrow-big-left.svg" class="icon" alt="Go back to activity logs page" />
    Back to the activity logs
  </a>
  
  <% if @orders.empty? %>
    <p class="empty">This customer has not made any orders yet.</p>
  <% else %>
    <div class="table_wrapper">
      <table class="admin_table">
        <tr>
          <th>ID</th>
          <th>Date Placed</th>
          <th>Price</th>
          <th>Reference ID</th>
        </tr>
        <% @orders.each do |order| %>
          <% order_link = "/admin-order?order_id=#{h order.order_unique_id}" %>
          <tr>
            <td><a class="see_entry" href="<%= order_link %>"><%= h order.order_unique_id %></a></td>
            <td><a class="see_entry" href="<%= order_link %>"><%= h(format_date(order.date_placed)) %></a></td>
            <td><a class="see_entry" href="<%= order_link %>"><%= h(format_price(order.price)) %></a></td>
            <td><a class="see_entry" href="<%= order_link %>"><%= h order.get_reference_id %></a></td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>
</div>

<%= erb :"common/admin_footer" %>
