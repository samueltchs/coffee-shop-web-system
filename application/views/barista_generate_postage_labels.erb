<!DOCTYPE HTML>
<HTML>
    <HEAD>
        <TITLE> BARISTA GENERATE POSTAGE LABELS PAGE </TITLE>
        <link rel="icon" type="image/svg+xml" href="/images/Favicon.svg">
        <link rel="stylesheet" href="../styles/barista.css">
        <meta charset="UTF-8">
    </HEAD>
    <BODY>
        <H1>
            Generate Postage Labels
        </H1>

        <FORM  style="margin-left:2vw; margin-bottom: 1vh"  method="get" action="/barista/main">
            <BUTTON class="menu_button_style" style="font-size:1.2rem;" type="submit">Main Menu</BUTTON>
        </FORM>

        <DIV id="whole_screen_box" class="box">
            <FORM method="post" action="/barista/generate-postage-labels" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 100%; height: 100%; gap: 2vh;">
                <BUTTON id="menu_button_properties" class="menu_button_style" type="submit" value="order" name="button">Generate Order Labels</BUTTON>
                <BUTTON id="menu_button_properties" class="menu_button_style" type="submit" value="refund" name="button">Generate Refund Labels</BUTTON>
            </FORM>
        </DIV>
    </BODY>
</HTML>