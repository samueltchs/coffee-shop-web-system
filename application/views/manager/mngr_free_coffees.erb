<div id="signup_and_date_container">
  <div id="signup_container">
    <span>Total Free Coffees Redeemed: <%= @total_redeemed %></span>
  </div>

  <div id="date_range_container">
    <form method="get" action="/manager/free-coffees">
      <div>
        <label for="from_date">From:</label>
        <input type="date" id="from_date" name="from_date" value="<%= @from_date %>">
        <label for="to_date">To:</label>
        <input type="date" id="to_date" name="to_date" value="<%= @to_date %>">
      </div>
      <div>
        <input type="submit" id="submit_btn" value="Filter">
        <a id="reset_btn" href="/manager/free-coffees">Reset</a>
      </div>
    </form>
  </div>
</div>

<hr id="line">

<div class="table-container">
  <table class="scrollable-table">
    <tr>
      <th>Date</th>
      <th>Customer</th>
      <th>Drink</th>
      <th>Size</th>
      <th>Milk</th>
    </tr>
    <% if @free_coffees.empty? %>
      <tr>
        <td colspan="5" class="empty-state">
          No free coffees redeemed yet
        </td>
      </tr>
    <% else %>
      <% @free_coffees.each do |fc| %>
        <tr>
          <td><%= fc[:date] %></td>
          <td><%= fc[:customer] %></td>
          <td><%= fc[:product] %></td>
          <td><%= fc[:size] %></td>
          <td><%= fc[:milk] %></td>
        </tr>
      <% end %>
    <% end %>
  </table>
</div>