<div class="sales-tabs">
  <a href="/manager/sales/analytics" class="sales-tab <%= 'active' if @active_tab == 'overview' %>">Overview</a>
  <a href="/manager/sales/drinks" class="sales-tab <%= 'active' if @active_tab == 'drinks' %>">Drinks Sales</a>
  <a href="/manager/sales/beans" class="sales-tab <%= 'active' if @active_tab == 'beans' %>">Beans Sales</a>
  <a href="/manager/sales/top-products" class="sales-tab <%= 'active' if @active_tab == 'top' %>">Top Products</a>
  <a href="/manager/sales/top-customers" class="sales-tab <%= 'active' if @active_tab == 'customers' %>">Top Customers</a>
</div>

<div id="signup_and_date_container">
  <div id="date_range_container">
    <form method="get" action="/manager/sales/top-products">
      <div>
        <label for="from_date">From:</label>
        <input type="date" id="from_date" name="from_date" value="<%= @from_date %>">
        <label for="to_date">To:</label>
        <input type="date" id="to_date" name="to_date" value="<%= @to_date %>">
      </div>
      <div>
        <input type="submit" id="submit_btn" value="Filter">
        <a id="reset_btn" href="/manager/sales/top-products">Reset</a>
      </div>
    </form>
  </div>
</div>

<hr id="line">

<div class="table-container">
  <table class="scrollable-table">
    <tr>
      <th>#</th>
      <th>Product</th>
      <th>Type</th>
        <th class="numeric">Avg Price</th>
        <th class="numeric">Quantity Sold</th>
        <th class="numeric">Revenue</th>
    </tr>
    <% if @top_data.empty? %>
      <tr>
        <td colspan="6" class="empty-state">
          No sales data in this period
        </td>
      </tr>
    <% else %>
      <% @top_data.each_with_index do |prod, idx| %>
        <tr>
          <td class="rank-cell"><%= idx + 1 %></td>
          <td><%= prod[:name] %></td>
          <td class="type-cell"><%= prod[:type] %></td>
          <td class="numeric">£<%= sprintf("%.2f", prod[:avg_price]) %></td>
          <td class="numeric"><%= prod[:quantity] %></td>
          <td class="numeric">£<%= sprintf("%.2f", prod[:revenue]) %></td>
        </tr>
      <% end %>
    <% end %>
  </table>
</div>