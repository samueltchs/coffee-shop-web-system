<div id="signup_and_date_container">
  <div id="signup_container">
    <span>Total Complaints: <%= @total_count %></span>
  </div>

  <div id="date_range_container">
    <form method="get" action="/manager/complaints">
      <div>
        <label for="from_date">From:</label>
        <input type="date" id="from_date" name="from_date" value="<%= @from_date %>">
        <label for="to_date">To:</label>
        <input type="date" id="to_date" name="to_date" value="<%= @to_date %>">
      </div>
      <div>
        <input type="submit" id="submit_btn" value="Filter">
        <a id="reset_btn" href="/manager/complaints">Reset</a>
      </div>
    </form>
  </div>
</div>

<hr id="line">

<div class="table-container">
  <table class="scrollable-table">
    <tr>
      <th>Complaint ID</th>
      <th>Customer</th>
      <th>Complaint</th>
      <th>Status</th>
      <th>Date</th>
    </tr>   
    <% if @complaints.empty? %>
      <tr>
        <td colspan="5" class="empty-state">
          No complaints yet
        </td>
      </tr>
    <% else %>
      <% @complaints.each do |complaint| %>
        <tr>
          <td><%= complaint.complaint_id %></td>
          <td><%= complaint.get_customer_name %></td>
          <td class="complaint-cell">
            <button onclick="document.getElementById('dialog-<%= complaint.complaint_id %>').showModal()" class="complaint-link">
              <% if complaint.complaint_text.length > 60 %>
                <%= complaint.complaint_text[0..60] %>...
              <% else %>
                <%= complaint.complaint_text %>
              <% end %>
            </button>
            <dialog id="dialog-<%= complaint.complaint_id %>" class="complaint-dialog">
              <h3>Complaint #<%= complaint.complaint_id %></h3>
              <p class="complaint-meta"><strong>Customer:</strong> <%= complaint.get_customer_name %></p>
              <p class="complaint-meta-last"><strong>Date:</strong> <%= complaint.created_at %></p>
              <p class="complaint-body"><%= complaint.complaint_text %></p>
              <button onclick="document.getElementById('dialog-<%= complaint.complaint_id %>').close()" class="dialog-close">Close</button>
            </dialog>
          </td>
          <td><%= complaint.status %></td>
          <td><%= complaint.created_at %></td>
        </tr>
      <% end %>
    <% end %>
  </table>
</div>

