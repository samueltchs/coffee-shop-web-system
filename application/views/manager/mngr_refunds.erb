<div id="signup_and_date_container">
  <div id="signup_container">
    <span>Total Refunds: <%= @total_count %></span>
    <span>Total Amount: £<%= sprintf("%.2f", @total_refund_amount) %></span>
  </div>

  <div id="date_range_container">
    <form method="get" action="/manager/refunds">
      <div>
        <label for="from_date">From:</label>
        <input type="date" id="from_date" name="from_date" value="<%= @from_date %>">
        <label for="to_date">To:</label>
        <input type="date" id="to_date" name="to_date" value="<%= @to_date %>">
      </div>
      <div>
        <input type="submit" id="submit_btn" value="Filter">
        <a id="reset_btn" href="/manager/refunds">Reset</a>
      </div>
    </form>
  </div>
</div>

<hr id="line">

<div class="table-container">
  <table class="scrollable-table">
    <tr>
      <th>Refund ID</th>
      <th>Customer</th>
      <th>Reason</th>
      <th>Status</th>
      <th>Amount</th>
      <th>Date</th>
    </tr>
    <% if @refunds.empty? %>
      <tr>
        <td colspan="6" class="empty-state">
          No refunds data yet
        </td>
      </tr>
    <% else %>
      <% @refunds.each do |refund| %>
        <tr>
          <td><%= refund.refund_id %></td>
          <td><%= refund.get_customer_name %></td>
          <td><%= refund.refund_reason %></td>
          <td><%= refund.status %></td>
          <td>
            <% amt = refund.get_amount %>
            <% if amt.is_a?(Numeric) %>
              £<%= sprintf("%.2f", amt) %>
            <% else %>
              <%= amt %>
            <% end %>
          </td>
          <td><%= refund.created_at %></td>
        </tr>
      <% end %>
    <% end %>
  </table>
</div>
