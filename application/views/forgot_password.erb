<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= h @title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/Favicon.svg">
  <link rel="stylesheet" href="styles/customer_reset_pass.css">
</head>
<body>
  <div class="reset_page">
    <div class="reset_box">
      <h1><%= h @title %></h1>

      <% if @error %>
        <p class="warning"><%= h @error %></p>
      <% end %>

      <form action="/forgot-password" method="post">
        <p><label for="email">Enter your email address:</label></p>
        <p><input type="text" id="email" name="email" /></p>
        <p><label for="loyalty_number">Enter your loyalty card number:</label></p>
        <p><input type="text" id="loyalty_number" name="loyalty_number" /></p>
        <p><button type="submit">Continue</button></p>
      </form>

      <a class="reset_pass" href="/login">Go back to login page</a>
    </div>
  </div>
</body>
</html>
