<!DOCTYPE HTML>
<HTML>
    <HEAD>
        <TITLE> BARISTA GENERATE REFUND LABELS PAGE </TITLE>
        <link rel="icon" type="image/svg+xml" href="/images/Favicon.svg">
        <link rel="stylesheet" href="../styles/barista.css">
        <meta charset="UTF-8">
    </HEAD>
    <BODY>

        <H1>
            GENERATE REFUND LABELS
        </H1>

        <FORM style="margin-left:2vw; margin-bottom: 1vh" method="get" action="/barista/generate-postage-labels">
            <BUTTON class="menu_button_style" style="font-size:1.2rem;" type="submit">Go back</BUTTON>
        </FORM>

        <DIV id="whole_screen_box" class="box">
        
        <!-- Filters -->
        <%
            @filter_action = "/barista/generate-refund-postage-labels"
            @reset_path = "/barista/generate-refund-postage-labels"
            @show_loyalty_filter = true
            @show_barista_filter = false
            @show_fulfilment_filter = false
            @show_payment_status_filter = false
            @show_payment_method_filter = false
            @show_delivery_filter = false
            @show_tracking_filter = false
            @show_refund_status_filter = false
            @show_date_filters = true
        %>
        <%=erb :"barista/filters"%>

        <!-- Refunds Table -->
        <%
            @header_font_size = "calc(1.1vh + 2.3vw)"
            @row_font_size = "calc(0.9vh + 1.4vw)"
            @view_items_path = "/barista/generate-refund-postage-labels"
            @view_link_text = "View Label"
            @table_style = nil
        %>
        <%=erb :"barista/refunds_table"%>

        </DIV>

        <!-- Label Popup -->
        <DIV class="alert_popup"
            <%selected_refund = Refund.get_refund_by_id(params[:selected]) if params[:selected]%>
            <%='style="display: flex; gap: 2vh;"' if selected_refund%>
        >

            <FORM method="get" action="/barista/generate-refund-postage-labels" style="align-self: start;">
                <INPUT class="menu_button_style" style="font-size: calc(1.2vh + 0.9vw);" type="submit" value="Close">
            </FORM>

            <H2>Postage Label — Refund #<%=h selected_refund.refund_id if selected_refund%></H2>

            <%if selected_refund%>
            <%label_customer = selected_refund.get_customer%>
            <DIV style="
                border: 3px solid #000;
                border-radius: 6px;
                width: 420px;
                align-self: center;
                font-family: monospace;
                overflow: hidden;
            ">
                <DIV style="background: #000; color: #fff; text-align: center; padding: 8px 12px; font-size: 1rem; letter-spacing: 2px; font-weight: bold;">
                    RETURN POSTAGE LABEL
                </DIV>

                <DIV style="padding: 16px 20px; border-bottom: 2px dashed #000;">
                    <P style="font-size: 0.75rem; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 1px; color: #555;">From</P>
                    <%if label_customer%>
                        <P style="font-size: 1rem; margin: 0; font-weight: bold;"><%=h label_customer.name%></P>
                        <P style="margin: 2px 0;"><%=h label_customer.address_line_1%></P>
                        <%if label_customer.address_line_2 && !label_customer.address_line_2.to_s.strip.empty?%>
                        <P style="margin: 2px 0;"><%=h label_customer.address_line_2%></P>
                        <%end%>
                        <P style="margin: 2px 0;"><%=h label_customer.city%></P>
                        <P style="margin: 2px 0; font-weight: bold;"><%=h label_customer.postcode%></P>
                    <%else%>
                        <P style="margin: 0; color: #888;">Customer address unavailable</P>
                    <%end%>
                </DIV>

                <DIV style="padding: 16px 20px;">
                    <P style="font-size: 0.75rem; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 1px; color: #555;">To</P>
                    <P style="font-size: 1.1rem; margin: 0; font-weight: bold;">Badly Brewed Coffee</P>
                    <P style="margin: 2px 0;">17 Badly Brewed Coffee</P>
                    <P style="margin: 2px 0; font-weight: bold; font-size: 1.1rem; letter-spacing: 2px;">BBC17</P>
                </DIV>

                <DIV style="background: #f5f5f5; padding: 8px 20px; border-top: 1px solid #ccc; font-size: 0.8rem; color: #444;">
                    Refund Ref: <STRONG><%=h selected_refund.refund_id%></STRONG>
                </DIV>
            </DIV>

            <FORM method="get" action="/barista-send-refund-postage-label" style="align-self: center;">
                <INPUT type="hidden" name="refund_id" value="<%=h selected_refund.refund_id%>">
                <BUTTON class="menu_button_style" style="font-size: calc(1.2vh + 0.9vw);" type="submit">Send Email to Customer</BUTTON>
            </FORM>
            <%end%>

        </DIV>
    </BODY>
</HTML>
