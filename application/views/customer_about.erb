<!DOCTYPE html>
<html lang="en">
<% @title = "About Us" %>
<%= erb :customer_head %>
<body>
    <header>
        <%= erb :customer_navbar %>
        <div class="page-header">
            <h1>About Us</h1>
        </div>
    </header>
    <div class="main-content">
        <div class="about-text">
            <p>Hello! Welcome to Badly Brewed Coffee, an independent coffee shop in Sheffield</p>
            <p>We'd be happy to serve you one of our freshly prepared drinks in-store, and we have a range of coffee beans from across the world available to order online or in-store.</p>
            <p>Feel free to contact us with any questions! We at BBC look forward to seeing you!</p>
        </div>
    </div>
    <%= erb :customer_footer %>
</body>
</html>