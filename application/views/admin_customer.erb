<%= erb :"common/admin_header" %>

<%= erb :"common/admin_top" %>

<% if @customer.status == "Deleted" %>
  <h1>Deleted Customer</h1>
<% else %>
  <h1>Full Name: <%= h @customer.name %></h1>
<% end %>

<div class="details">
  <p>Unique Loyalty Card Number: <span class="user_detail"><%= h @customer.loyalty_number %></span></p>
  <p>Email: <span class="user_detail"><%= h @customer.email %></span></p>
  <p>Phone Number: <span class="user_detail"><%= h @customer.phone_number %></span></p>
  <p>Stamps: <span class="user_detail"><%= h @customer.stamps %></span></p>
  <% if @customer.status != "Deleted" %>
    <p>Registered At: <span class="user_detail"><%= h format_time(@customer.registered_time) %></span></p>
    <p>
      Inactive for:
      <% if @active %>
        <span class="user_detail"><%= h @inactivity_time %></span>
      <% else %>
        <span class="user_detail">No activity has been recorded</span>
      <% end %>

      <% if @five_months_inactive && @customer.status == "Active" %>
        <a class="buttons" href="/admin-inactivity-warning-email?loyalty_number=<%= h @customer.loyalty_number %>">
          <img src="icons/mail.svg" class="icon" alt="View the inactivity warning email that was sent" />
          View the inactivity warning email
        </a>
      <% end %>
    </p>
  <% end %>
  <p>
    Status: <span class="user_detail"><%= h @customer.status %></span>

    <% if @customer.status == "Flagged" && @four_days_since_flagged %>
      <a class="buttons" href="/admin-suspension-warning-email?loyalty_number=<%= h @customer.loyalty_number %>">
        <img src="icons/mail.svg" class="icon" alt="View the suspension warning email that was sent" />
        View the suspension warning email
      </a>
    <% end %>

    <% if @customer.status == "Suspended" %>
      <% if @customer.suspension_reason_id == 1 %>
        <a class="buttons" href="/admin-inactivity-suspension-email?loyalty_number=<%= h @customer.loyalty_number %>">
          <img src="icons/mail.svg" class="icon" alt="View the customer account suspension email that was sent" />
          View the account suspension email
        </a>
      <% elsif @customer.suspension_reason_id == 2 %>
        <a class="buttons" href="/admin-disciplinary-suspension-email?loyalty_number=<%= h @customer.loyalty_number %>">
          <img src="icons/mail.svg" class="icon" alt="View the customer disciplinary suspension email that was sent" />
          View the account suspension email
        </a>
      <% end %>
    <% end %>
  </p>
  <% if @customer.status == "Deleted" %>
    <p>Deleted at: <%= h format_time(@customer.deleted_at) %></p>
  <% else %>
    <% if @customer.status == "Suspended" %>
      <p>Suspended at: <%= h format_time(@customer.suspended_at) %></p>
    <% end %>

    <% if ["Flagged", "Suspended"].include?(@customer.status) && @customer.flagged_at %>
      <p>Flagged at: <%= h format_time(@customer.flagged_at) %></p>
    <% end %>
  <% end %>
</div>

<div class="config">
  <% if @suspension_success %>
    <p><span class="success"><%= h @suspension_success %></span></p>
  <% end %>

  <% if @deletion_success %>
    <p><span class="success"><%= h @deletion_success %></span></p>
  <% elsif @deletion_error %>
    <p><span class="error"><%= h @deletion_error %></span></p>
  <% end %>

  <% if @reactivation_success %>
    <a class="buttons" href="/admin-account-reactivated-email?loyalty_number=<%= h @customer.loyalty_number %>">
      <img src="icons/mail.svg" class="icon" alt="View the customer account reactivation email that was sent" />
      View the account reactivation email
    </a>
    <p><span class="success"><%= h @reactivation_success %></span></p>
  <% end %>

  <div class="config_account">
    <% if !["Suspended", "Deleted"].include?(@customer.status) %>
      <a class="buttons" href="/admin-reset-pass-email?loyalty_number=<%= h @customer.loyalty_number %>">
        <img src="icons/mail.svg" class="icon" alt="Send customer reset password email" />
        Send reset password email
      </a>
    <% end %>

    <% if ["Active", "Flagged"].include?(@customer.status) %>
      <form action="/admin-customer-suspend" method="post"
        <% if @customer.status == "Active" %>
          onsubmit="return confirm(
            'Are you sure you want to suspend this customer account? They have not been flagged for inactivity.'
          );"
        <% else %>
          onsubmit="return confirm(
            'Are you sure you want to suspend this customer account? The 5 day grace period has yet to pass.'
          );"
        <% end %>
      >
        <input type="hidden" name="loyalty_number" value="<%= h @customer.loyalty_number %>" />
        <button type="submit" class="buttons">
          <img src="icons/lock.svg" class="icon" alt="Suspend customer account" />
          Suspend Account
        </button>
      </form>
    <% end %>

    <% if @customer.status == "Suspended" && (@customer.suspension_reason_id == 2 || @three_months_since_suspended) %>
      <form action="/admin-customer-delete" method="post"
        onsubmit="return confirm('Are you sure you want to delete this customer account?');">
        <input type="hidden" name="loyalty_number" value="<%= h @customer.loyalty_number %>" />
        <button type="submit" class="buttons">
          <img src="icons/trash-2.svg" class="icon" alt="Delete customer account" />
          Delete Account
        </button>
      </form>
    <% end %>

    <% if @customer.status == "Deleted" %>
      <% if @customer.deletion_reason_id == 1 %>
        <a class="buttons" href="/admin-inactivity-deletion-email?loyalty_number=<%= h @customer.loyalty_number %>">
          <img src="icons/mail.svg" class="icon" alt="View the customer account deletion email that was sent" />
          View the account deletion email
        </a>
      <% elsif @customer.deletion_reason_id == 2 %>
        <a class="buttons" href="/admin-disciplinary-deletion-email?loyalty_number=<%= h @customer.loyalty_number %>">
          <img src="icons/mail.svg" class="icon" alt="View the customer disciplinary deletion email that was sent" />
          View the account deletion email
        </a>
      <% end %>
    <% end %>

    <% if @customer.status == "Suspended" && (@customer.suspension_reason_id == 2 || !@three_months_since_suspended) %>
      <form action="/admin-customer-reactivate" method="post">
        <input type="hidden" name="loyalty_number" value="<%= h @customer.loyalty_number %>" />
        <button type="submit" class="buttons">
          <img src="icons/refresh-cw.svg" class="icon" alt="Reactivate customer account" />
          Reactivate Account
        </button>
      </form>
    <% end %>

    <a class="buttons" href="/admin-customer-activity-logs?loyalty_number=<%= h @customer.loyalty_number %>">
      <img src="icons/eye.svg" class="icon" alt="View customer activity logs" />
      View Activity Logs 
    </a>

    <% if !["Suspended", "Deleted"].include?(@customer.status) && @top_items.length >= 3 %>
      <form action="/admin-send-ad" method="post">
        <input type="hidden" name="loyalty_number" value="<%= h @customer.loyalty_number %>" />
        <button type="submit" class="buttons">
          <img src="icons/send.svg" class="icon" alt="Send customer an ad" />
          Send ad
        </button>
      </form>
    <% elsif !["Suspended", "Deleted"].include?(@customer.status) %>
      <p class="empty">Not enough data to generate ad</p>
    <% end %>
  </div>
</div>

<%= erb :"common/admin_footer" %>
